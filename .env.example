# Copia a .env.local y rellena. .env.local no se commitea.

# URL canonica del sitio. Sin esto, metadata/OG/sitemap/robots caen al apex
# (https://rodrigobermejo.com) mientras el sitio vive en www. -> canonical divergente.
# Debe estar seteada en produccion.
NEXT_PUBLIC_SITE_URL=https://www.rodrigobermejo.com

# Google Analytics 4. Si falta, el componente Analytics no renderiza nada.
NEXT_PUBLIC_GA_ID=

# Buttondown, para /api/subscribe. Solo servidor: nunca prefijar con NEXT_PUBLIC_.
BUTTONDOWN_API_KEY=

# --- Canal editorial: las dos variables OBLIGATORIAS -------------------------------
#
# docs/plataforma/02-editorial.md §8.3. Sin cualquiera de las dos, el canal ABORTA al
# arrancar --- antes de leer un feed, antes de abrir un archivo --- y no escribe nada.
# NO tienen valor por defecto, y esa ausencia es intencional: un default dentro del
# repositorio es exactamente como el estado del canal acaba publicado en un repositorio
# publico sin que nadie lo note. Asi llegaron cinco archivos de estado a este repo.
#
# Las rutas van FUERA de todo arbol de trabajo de git --- un directorio privado dentro de
# un repo privado tampoco vale: la regla es que el estado NO esta versionado, no que el
# repositorio sea discreto.
#
# Se dejan VACIAS aqui a proposito. Una ruta escrita en un archivo versionado es una ruta
# publicada, y ademas volveria a fabricar el default que esto existe para quitar.
# Para migrar el estado que hoy vive en disco:
# docs/plataforma/programacion/01-migrar-el-estado-editorial.md
#
# Bitacora, fallos y el vistos.jsonl heredado.
EDITORIAL_ESTADO_DIR=
# Borradores y redacciones, antes de que un humano autorice nada.
EDITORIAL_REDACCIONES_DIR=
